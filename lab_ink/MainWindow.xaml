<Window x:Class="Clicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clicker" Height="480" Width="750"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="tbEnemyName" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock x:Name="tbEnemyHp" FontSize="16" Margin="0,0,0,4"/>
            <TextBlock x:Name="tbEnemyGold" FontSize="16" Margin="0,0,0,20"/>

            <Button Content="Клик" Width="140" Height="135" FontSize="18"
        Click="Enemy_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,0,0">
            <TextBlock x:Name="tbLevel" FontSize="18" Margin="0,0,0,10"/>
            <TextBlock x:Name="tbGold" FontSize="18" Margin="0,0,0,10"/>
            <TextBlock x:Name="tbDamage" FontSize="18" Margin="0,0,0,10"/>
            <TextBlock x:Name="tbUpgradeCost" FontSize="16" Margin="0,0,0,20" Foreground="#555"/>

            <Button Content="Upgrade" Width="140" Height="38" FontSize="15"
                    Click="Upgrade_Click" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</Window>