<Window x:Class="Clicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clicker" Height="450" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="tbEnemyName" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="tbEnemyHp" Margin="0,10,0,5"/>
            <TextBlock x:Name="tbEnemyGold" Margin="0,0,0,20"/>

            <Border BorderBrush="Gray" BorderThickness="1" Width="120" Height="120" 
                    HorizontalAlignment="Left" MouseLeftButtonDown="Enemy_Click">
                <TextBlock Text="Клик" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="tbLevel" FontSize="16"/>
            <TextBlock x:Name="tbGold" FontSize="16" Margin="0,8"/>
            <TextBlock x:Name="tbDamage" FontSize="16" Margin="0,0,0,20"/>

            <Button Content="Улучшить" Width="120" Height="35" 
                    Click="Upgrade_Click" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</Window>